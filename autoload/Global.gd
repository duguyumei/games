## Takes SCHEMA and generates fast lookup tables used for mapping data types
## in the framework. This automates and centralizes a lot of extremely tedious
## schema maintenance and enables useful behavior like register_rod() for test data generation,
## and file/mod loading through data table mapping.
func _generate_schema() -> void:
	for schema_row: Array in SCHEMA:
		var data_script_string: String = schema_row[0]
		var data_script: Script = schema_row[1]
		var data_lookup_table_property_name: String = schema_row[2]
		var read_only_data_folder_paths: Array[String] = []
		read_only_data_folder_paths.assign(schema_row[3])
		
		READ_ONLY_GETTER_SCHEMA[data_script] = data_lookup_table_property_name
		CLASS_NAME_TO_CLASS[data_script_string] = data_script

## Allows for automatically registering a Read-Only-Data object into its proper lookup table. This is extremely
## useful for generic data pipelines, and streamlines test data code. See READ_ONLY_GETTER_SCHEMA.
func register_rod(serializeable_data: SerializableData, allow_collisions: bool = true) -> void:
	var script_class: Script = serializeable_data.get_script() # get the type of the object
	if not READ_ONLY_GETTER_SCHEMA.has(script_class):
		breakpoint
		DebugLogger.log_error("Global.register_rod(): No lookup table for {0}".format([script_class]))
		get_tree().quit()
	else:
		# find the matching lookup table of the SerializeableData
		var lookup_table_property_name: String = READ_ONLY_GETTER_SCHEMA[script_class]
		var lookup_table: Dictionary = get(lookup_table_property_name)
		if serializeable_data.object_id == "":
			breakpoint
			DebugLogger.log_error("Global.register_rod(): Empty object ID")
			get_tree().quit()
		if lookup_table.has(serializeable_data.object_id) and not allow_collisions:
			breakpoint
			DebugLogger.log_error("Global.register_rod(): Object ID collision in {0} for ID: {1}".format([lookup_table_property_name, serializeable_data.object_id]))
			get_tree().quit()
		# register read only object into lookup table
		lookup_table[serializeable_data.object_id] = serializeable_data
		# reassign the lookup table to Global
		set(lookup_table_property_name, lookup_table)

#endregion

func _ready():
	### Schema
	# generate the schema. This must be done before everything else in Global or errors will ensue
	# when loading data or generating test data.
	_generate_schema()
	# make SerializableData make a mapping of global classes of its type to class.
	# this must be done before everything else or you cannot load objects from file.
	SerializableData.build_serializable_script_cache()
	
	### Load Profile and User Settings
	FileLoader.load_profile()
	FileLoader.load_user_settings()
	
	### Production data generation
	#GlobalProdDataGenerator.generate_production_data()
	#ProfileData.ENABLE_ALL_DIFFICULTIES = false
	
	### Test data generation
	GlobalTestDataGenerator.generate_test_data()
	
	### Testing flags
	ProfileData.ENABLE_ALL_DIFFICULTIES = true
	StatsHandler.TRACK_RUN_HISTORY = true
	
	### Modding and external file loads
	#FileLoader._generate_mod_list_data() # generates the mod list used for loading ALL external files
	#FileLoader._generate_base_mod_data() # generates mod data for base game. uncomment, run once, then comment back after updating SCHEMA
	FileLoader.load_read_only_data() # loads all mods and base game exteral data
	
	### Generated from loaded data
	# custom signals generated from CustomSignalData
	Signals.register_all_custom_signals()
	# generate cached filters from CardPackData
	Global._generate_card_pack_cache()
	# generate cached filters from ArtifactPackData
	Global._generate_artifact_pack_cache()
	# generate cached filters from ConsumablePackData
	Global._generate_consumable_pack_cache()
	# force generate all animations
	FileLoader.generate_all_animations()

	# 商店刷新只监听已提交的节点完成事件，打开页面本身不会生成候选。
	Signals.node_completed.connect(_on_node_completed)
	Signals.shop_transaction_committed.connect(_on_shop_transaction_committed)
	Signals.combat_started.connect(_on_qi_combat_started)
	Signals.combat_ended.connect(_on_qi_combat_ended)
	Signals.run_ended.connect(_on_qi_run_ended)
	
	### Exporting Data
	# FileLoader.export_read_only_data() # uncomment to output all unexported test data to file


#region Run
## Starts a new run under a given seed with a given character
func start_run(character_object_id: String, run_seed: int, difficulty_level: int = 0, custom_run_modifier_object_ids: Array[String] = []) -> void:
	var character_data: CharacterData = get_character_data(character_object_id)
	
	# initialize player data from a prototype using selected character
	player_data = get_player_data_from_prototype(character_data.character_player_id)
	is_run = true # run is considered started
	
	# initialize run rng
	player_data.player_run_seed = run_seed
	
	#region Run Data Initialization
	# generate artifact pool for the run
	# NOTE: This holds all artifacts, regardless of packs
	player_data.initialize_artifact_pool()
	
	# add starting artifacts to player
	for artifact_id in character_data.character_starting_artifact_ids:
		player_data.add_artifact(artifact_id)
	
	# add starting cards to player
	for card_object_id in character_data.character_starting_card_object_ids:
		player_data.player_deck.append(get_card_data_from_prototype(card_object_id))

	# 真气默认使用完整的 52 张标准扑克牌；角色可以通过固定配置改为指定牌面集合。
	if character_data.character_starting_qi_object_ids.is_empty():
		player_data.add_standard_qi_deck()
	else:
		for qi_object_id: String in character_data.character_starting_qi_object_ids:
			var qi_data: QiData = get_qi_data_from_prototype(qi_object_id)
			if qi_data != null:
				player_data.add_qi_instance(qi_data)
	
	# card draft
	player_data.reward_draft_card_pack_ids.assign(character_data.character_starting_card_draft_card_pack_ids)
	# artifact draft
	player_data.player_artifact_pack_ids.assign(character_data.character_starting_artifact_pack_ids)
	# consumable draft
	player_data.player_consumable_pack_ids.assign(character_data.character_starting_consumable_pack_ids)
	
	# money and health
	player_data.player_money = character_data.character_starting_money
	player_data.player_health_max = character_data.character_starting_health
	player_data.player_health = character_data.character_starting_health
	
	# location, act, and difficult
	player_data.player_location_id = "location_0" # hardcoded starting location
	player_data.player_waiting_for_node_selection = false
	player_data.player_act = 1
	player_data.player_run_difficulty_level = difficulty_level
	
	# determine the run modifiers
	player_data.player_run_modifier_object_ids = []
	# automatic run modifiers
	for run_modifier_id: String in Global._id_to_run_modifier_data:
		var run_modifier_data: RunModifierData = Global.get_run_modifier_data(run_modifier_id)
		if run_modifier_data.run_modifier_is_automatic:
			player_data.player_run_modifier_object_ids.append(run_modifier_id)
	# difficulty run modifiers
	if difficulty_level > 0:
		var difficulty_amount_max: int = min(difficulty_level, len(STANDARD_DIFFICULTY_RUN_MODIFIER_IDS))
		player_data.player_run_modifier_object_ids += STANDARD_DIFFICULTY_RUN_MODIFIER_IDS.slice(0, difficulty_amount_max, 1, true)
	player_data.player_run_modifier_object_ids += custom_run_modifier_object_ids
	#endregion
	
	# Run Stats
	player_data.player_run_stats = RunStatsData.new()
	StatsHandler.current_run_stats = player_data.player_run_stats # update reference
	
	
	# Uncomment these for adding test stuff to the player
	# GlobalTestDataGenerator.add_test_cards_to_player_deck()
	# GlobalTestDataGenerator.add_test_artifacts_to_player()
	# GlobalTestDataGenerator.add_test_consumables_to_player()
	
	# connect signals and generate caches
	player_data.init()
	
	# run modifiers
	perform_start_of_run_modifiers()
	
	# generate world
	ActionGenerator.generate_act("act_1", true)

	# 新本局只在第一次进入地图前生成一次完整商店。
	ensure_shop_initialized()
	
	# save immediately at start of run
	FileLoader.autosave()
	
	Signals.run_started.emit()
	Signals.map_location_selected.emit(get_player_location_data())	# simulate visiting the first location
	
	# simulate a win
	#await get_tree().create_timer(5).timeout
	#Signals.run_victory.emit()

## 创建一场新的真气战斗现场；重复进入战斗会丢弃旧的未保存现场。
func begin_qi_battle_state() -> BattleQiState:
	battle_qi_state = BattleQiState.new()
	return battle_qi_state

## 在唯一敌人生成后初始化敌我真气牌区；失败时不留下半成品牌区。
func initialize_qi_battle_zones(enemy_data: EnemyData) -> bool:
	if enemy_data == null or player_data == null:
		return false
	# 动态槽位或内容移除后，非法配装不能带入战斗现场。
	if not player_data.is_current_gongfa_loadout_valid() \
		or not player_data.validate_neigong_loadout(player_data.player_equipped_neigong_uids):
		DebugLogger.log_error("Cannot start qi combat with an invalid loadout")
		return false
	if battle_qi_state == null:
		begin_qi_battle_state()
	var enemy_qi_deck: Array[QiData] = []
	var enemy_definition_ids: Array[String] = enemy_data.enemy_qi_deck_definition_ids
	if enemy_definition_ids.is_empty():
		enemy_definition_ids = QiData.get_standard_deck_object_ids()
	for qi_definition_id: String in enemy_definition_ids:
		var qi_data: QiData = get_qi_data_from_prototype(qi_definition_id)
		if qi_data == null:
			DebugLogger.log_error(
				"Enemy qi deck contains unknown definition: %s" % qi_definition_id)
			battle_qi_state.clear_battle()
			return false
		enemy_qi_deck.append(qi_data)
	var enemy_instance_id: String = enemy_data.object_uid
	if enemy_instance_id == "":
		enemy_instance_id = enemy_data.object_id
	var initialized: bool = battle_qi_state.initialize_zones(
		player_data.player_qi_deck,
		enemy_qi_deck,
		player_data.get_player_rng("rng_qi_player_shuffle"),
		player_data.get_player_rng("rng_qi_enemy_shuffle"),
		enemy_instance_id)
	if initialized:
		battle_qi_state.initialize_loadouts(player_data)
	return initialized

## 返回当前战斗真气现场；没有战斗时返回 null。
func get_qi_battle_state() -> BattleQiState:
	return battle_qi_state

## 确认后立即计算牌型、同气和功法值，并把功法效果排入现有行为队列。
func resolve_qi_action(request: QiActionRequest) -> bool:
	if battle_qi_state == null or request == null \
		or not battle_qi_state.is_action_frozen():
		return false
	if not QiActionResolver.calculate_request_results(request, battle_qi_state):
		battle_qi_state.cancel_frozen_action(request)
		Signals.qi_zones_changed.emit()
		return false
	# 真气只有在确认通过基础校验后才发送正式打出事件。
	for qi_instance_uid: String in request.player_qi_instance_uids:
		notify_qi_event(BattleQiState.EVENT_QI_PLAYED, qi_instance_uid, request.action_token)
	for qi_instance_uid: String in request.enemy_qi_instance_uids:
		notify_qi_event(BattleQiState.EVENT_QI_PLAYED, qi_instance_uid, request.action_token)
	var generated_actions: Array[BaseAction] = QiActionResolver.build_effect_actions(
		request, battle_qi_state)
	var finish_action: ActionResolveQiAction = ActionResolveQiAction.new()
	finish_action.init_qi_action(request)
	generated_actions.append(finish_action)
	ActionHandler.add_actions(generated_actions, true)
	return true

## 由真气行动收尾动作调用，完成冻结请求并准备下一次行动。
func complete_qi_action(request: QiActionRequest) -> bool:
	if battle_qi_state == null or not battle_qi_state.complete_qi_action(request):
		return false
	Signals.qi_zones_changed.emit()
	Signals.qi_action_completed.emit(request)
	return true

## 向当前真气战斗现场发送一个已提交事件。
func notify_qi_event(
		event_id: String,
		qi_instance_uid: String = "",
		event_token: String = "") -> Array[String]:
	if battle_qi_state == null:
		if qi_instance_uid == "":
			return []
		var persistent_qi: QiData = player_data.get_owned_qi(qi_instance_uid)
		return persistent_qi.notify_run_qi_event(event_id) if persistent_qi != null else []
	if battle_qi_state.has_processed_event(event_token):
		return []
	var removed_definition_ids: Array[String] = battle_qi_state.notify_qi_event(
		event_id, qi_instance_uid, event_token)
	if qi_instance_uid != "":
		var qi_data: QiData = player_data.get_owned_qi(qi_instance_uid)
		if qi_data != null:
			removed_definition_ids.append_array(qi_data.notify_run_qi_event(event_id))
	return removed_definition_ids

## 战斗结束后清理真气现场，不触发任何本局重塑或异状行为。
func end_qi_battle_state() -> void:
	if battle_qi_state == null:
		return
	battle_qi_state.notify_qi_event(BattleQiState.EVENT_BATTLE_ENDED, "", "combat_end")
	for qi_data: QiData in player_data.player_qi_deck:
		qi_data.notify_run_qi_event(BattleQiState.EVENT_BATTLE_ENDED)
	battle_qi_state = null

## 战斗开始时创建真气现场；旧 CardData 类型保留兼容，但标准战斗不再使用旧牌区。
func _on_qi_combat_started(_event_id: String) -> void:
	begin_qi_battle_state()

## 战斗结束时丢弃所有临时真气状态。
func _on_qi_combat_ended() -> void:
	end_qi_battle_state()

## 本局结束时清理可能残留的战斗现场。
func _on_qi_run_ended() -> void:
	battle_qi_state = null

## Used for end_run().
enum RUN_ENDS {QUIT, LOSS, VICTORY}

## Ends the player's current run under the given status.
func end_run(run_end_state: int = RUN_ENDS.QUIT) -> void:
	match run_end_state:
		RUN_ENDS.QUIT:
			pass # no changes, run should be autosaved already
		RUN_ENDS.LOSS:
			FileLoader.delete_save()
			StatsHandler.lose_run() # store loss in profile
			FileLoader.save_profile()
		RUN_ENDS.VICTORY:
			FileLoader.delete_save()
			StatsHandler.win_run() # store win in profile
			FileLoader.save_profile()
	
	is_run = false
	Signals.run_ended.emit()

## Stores a loss in the player's profile and deletes save, without starting a new run
func forfeit_run_from_title() -> void:
	FileLoader.load_game(false)
	FileLoader.delete_save()
	StatsHandler.lose_run()
	FileLoader.save_profile()

## Returns whether the run should end or not
func is_end_of_run() -> bool:
	if not is_end_of_act():
		return false # more locations ahead
	if player_data.player_act_max <= 0:
		return false # endless mode
	if player_data.player_act < player_data.player_act_max:
		return false # more acts ahead
	return true

## Performs any custom logic for each modifier done at the very beginning of a run
func perform_start_of_run_modifiers() -> void:
	for run_modifier_object_id in Global.player_data.player_run_modifier_object_ids:
		var run_modifier_data: RunModifierData = Global.get_run_modifier_data(run_modifier_object_id)
		if run_modifier_data == null:
			DebugLogger.log_error("Global.perform_start_of_run_modifiers(): No RunData with id of \"{0}\"".format([run_modifier_object_id]))
			continue
		else:
			var run_modifier_modifier_script_path: String = run_modifier_data.run_modifier_modifier_script_path
			if run_modifier_modifier_script_path != "":
				var run_modidifier_script_asset = load(run_modifier_modifier_script_path)
				var run_modifier: BaseRunModifier = run_modidifier_script_asset.new()
				run_modifier.run_start_modification()

func pause_game() -> void:
	get_tree().paused = true
	Signals.game_paused.emit()
	
func unpause_game() -> void:
	get_tree().paused = false
	Signals.game_unpaused.emit()

