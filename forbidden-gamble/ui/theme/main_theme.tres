[ext_resource type="FontFile" path="res://assets/fonts/NotoSansSC.ttf" id="1_noto"]

; 纸墨主题（阶段一基线）：纸色面板 + 墨色描边 + 朱砂点缀。
; 色板与既有 screen（title/stronghold 的 Bg/PanelCard）取同源值，避免两套观感。

