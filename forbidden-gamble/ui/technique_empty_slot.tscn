[gd_scene format=3]

; 功法层空位占位卡（编辑器模板）：technique_bar.gd 按缺位数实例化，
; 样式在此调整即可，运行期只摆位置。

[sub_resource type="StyleBoxFlat" id="empty_bg"]
bg_color = Color(0.93, 0.89, 0.8, 0.25)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.5, 0.48, 0.44, 0.6)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="TechniqueEmptySlot" type="Panel"]
custom_minimum_size = Vector2(150, 210)
size = Vector2(150, 210)
mouse_filter = 2
theme_override_styles/panel = SubResource("empty_bg")

[node name="EmptyLabel" type="Label" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.5, 0.48, 0.44, 0.6)
theme_override_font_sizes/font_size = 16
text = "空位"
horizontal_alignment = 1
vertical_alignment = 1
