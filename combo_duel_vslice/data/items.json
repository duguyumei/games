    },
    {
      "id": "astronomer",
      "name": "天文学家",
      "kind": "item",
      "status": "design_only",
      "unique": true,
      "description": "候选物品：依赖修习价格减免平台，当前不进入正式商店。"
    },
    {
      "id": "overstock_plus_two",
      "name": "库存过剩",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "新修习商店生成时普通商品栏槽位 +2；不追溯扩充当前商店。",
      "behaviors": [
        {
          "id": "run_int_query_modifier",
          "configuration": {
            "rules": [
              {
                "hook": "practice_normal_slot_count_query",
                "operation": "add",
                "operand": 2,
                "filters": {"group": "normal", "operation": "generate_shop"}
              }
            ]
          }
        }
      ]
    },
    {
      "id": "awakened_qi_weight_x4",
      "name": "焕彩",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "已启用的永久觉醒真气普通商品类别出现权重 ×4。",
      "behaviors": [
        {
          "id": "run_int_query_modifier",
          "configuration": {
            "rules": [
              {
                "hook": "practice_offer_weight_query",
                "operation": "multiply",
                "operand": 4,
                "filters": {
                  "group": "normal",
                  "category_id": "awakened_qi",
                  "content_kind": "awakened_qi",
                  "candidate_provider": "generated_awakened_qi"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "telescope_insight_focus",
      "name": "望远镜",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "心得包保证一个本局最高成功牌型心得；心得槽位增量由 +1 改为 +2。",
      "behaviors": [
        {
          "id": "run_int_query_modifier",
          "configuration": {
            "rules": [
              {
                "hook": "practice_pack_candidate_priority_query",
                "operation": "maximum",
                "operand": 1,
                "filters": {
                  "content_kind": "insight",
                  "candidate_provider": "static_ids"
                },
                "history_hand_match": true
              },
              {
                "hook": "insight_slot_gain_query",
                "operation": "add",
                "operand": 1,
                "filters": {}
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pill_shop_weight_x4",
      "name": "塔罗大亨",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "普通商品栏中单份丹药类别出现权重 ×4；不影响丹药包。",
      "behaviors": [
        {
          "id": "run_int_query_modifier",
          "configuration": {
            "rules": [
              {
                "hook": "practice_offer_weight_query",
                "operation": "multiply",
                "operand": 4,
                "filters": {
                  "group": "normal",
                  "offer_kind": "consumable",
                  "content_kind": "pill"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "insight_shop_weight_x4",
      "name": "星球牌商人",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "普通商品栏中单份心得类别出现权重 ×4；不影响心得包。",
      "behaviors": [
        {
          "id": "run_int_query_modifier",
          "configuration": {
            "rules": [
              {
                "hook": "practice_offer_weight_query",
                "operation": "multiply",
                "operand": 4,
                "filters": {
                  "group": "normal",
                  "offer_kind": "consumable",
                  "content_kind": "insight"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "awakened_qi_in_normal_shop",
      "name": "幻象",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "启用普通商品栏中的单张永久觉醒真气类别；每张候选完整冻结。",
      "behaviors": [
        {
          "id": "run_int_query_modifier",
          "configuration": {
            "rules": [
              {
                "hook": "practice_offer_category_enabled_query",
                "operation": "maximum",
                "operand": 1,
                "filters": {
                  "group": "normal",
                  "category_id": "awakened_qi",
                  "candidate_provider": "generated_awakened_qi"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "deck_growth_and_reshape_vitality",
      "name": "纳气养命",
      "kind": "item",
      "status": "formal",
      "unique": true,
      "price": 8,
      "description": "每向本局牌组中永久新增1张真气，最大生命+1。每成功重塑1张我方真气，恢复1点生命。",
      "marker_definitions": [
        {
          "id": "permanent_qi_growth",
          "scope": "run",
          "public": true,
          "display_name": "纳气养命",
          "contributes_to": "max_life",
          "forget_policy": "clear",
          "initial_value": 0
        }
      ],
      "behaviors": [
        {
          "id": "run_fact_effects",
          "configuration": {
            "rules": [
              {
                "hook": "run_qi_permanently_added",
                "filters": {"scope": "run"},
                "effects": [
                  {
                    "op": "write_source_marker",
                    "marker_id": "permanent_qi_growth",
                    "operation": "add",
                    "amount": 1
                  }
                ]
              },
              {
                "hook": "qi_reshape_committed",
                "filters": {
                  "scope": "run",
                  "persistence": "permanent",
                  "actual_change_count_positive": true
                },
                "effects": [
                  {"op": "heal_life", "amount": 1}
                ]
              }
            ]
          }
        },
        {
          "id": "battle_effects",
          "configuration": {
            "rules": [
              {
                "hook": "run_qi_permanently_added",
                "filters": {
                  "holder_is_owner": true,
                  "scope": "battle",
                  "persistence": "permanent"
                },
                "effects": [
                  {
                    "op": "write_source_marker",
                    "marker_id": "permanent_qi_growth",
                    "operation": "add",
                    "amount": 1
                  }
                ]
              },
              {
                "hook": "qi_reshape_committed",
                "filters": {
                  "holder_is_owner": true,
                  "scope": "battle",
                  "persistence": "permanent",
                  "actual_change_count_positive": true
                },
                "effects": [
                  {"op": "heal_life", "side": "owner", "amount": 1}
                ]
              },
              {
                "hook": "card_state_changed",
                "filters": {
                  "holder_is_owner": true,
                  "persistence": "temporary",
                  "change_domain": "temporary_reshape",
                  "operation_in": ["apply", "replace"],
                  "actual_change_count_positive": true
                },
                "effects": [
                  {"op": "heal_life", "side": "owner", "amount": 1}
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
