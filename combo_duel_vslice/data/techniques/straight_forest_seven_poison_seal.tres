automatic_triggers = [{"id":"seven_poison_seal","event":"poison_trigger_completed","filters":{"event_actor_is_opponent":true,"actual_life_loss_positive":true},"timing":"immediate","progress":{"marker_id":"enemy_poison_life_loss","add":{"kind":"event_field","capture":"event","field":"actual_life_loss"},"threshold":20,"consume":20,"retain_overflow":true},"p0":{"kind":"constant","value":20}}]
description = "主动触发时获得floor(P/2)点防御。敌方每因毒累计实际损失20点生命，消耗20点记录并以特殊P₀=20自动触发：造成floor(P/2)点真伤，并使敌方随机1张手牌中的真气获得1层封禁；没有合法目标时，改为再造成floor(P/2)点真伤。自动分支真伤不加入毒伤进度，溢出生命损失保留。"
