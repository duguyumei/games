effects = [{"op":"defense","phase":"prepare","amount":{"kind":"power_fraction","numerator":1,"denominator":2,"minimum":0}},{"op":"select_option","phase":"prepare","choice_id":"borrow_momentum_poison","prompt":"是否清空当前连势催蛊","chooser":"actor","minimum":0,"maximum":1,"insufficient_policy":"use_available","options":[{"id":"consume","label":"清空连势"}],"capture":"consume_choice"},{"op":"write_momentum","phase":"prepare","operation":"clear","amount":0,"capture":"spent_momentum","when":{"capture_nonempty":"consume_choice"}},{"op":"grant_poison_damage_modifier","phase":"prepare","affected_side":"target","fixed":0,"percent":{"kind":"multiply","values":[5,{"kind":"subtract","left":{"kind":"capture_field_first","capture":"spent_momentum","field":"before"},"right":{"kind":"capture_field_first","capture":"spent_momentum","field":"after"}}]},"remaining_hits":-1,"expiry":"round_end","remaining_rounds":2,"public":true,"capture":"borrowed_poison_modifier","when":{"value_greater_than":{"value":{"kind":"capture_field_first","capture":"spent_momentum","field":"before"},"threshold":{"kind":"capture_field_first","capture":"spent_momentum","field":"after"}}}}]
