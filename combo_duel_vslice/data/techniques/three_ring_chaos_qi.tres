effects = [{"op":"damage","amount":{"kind":"power_fraction","numerator":1,"denominator":2}},{"op":"register_delayed_effects","timing":"turn_end","occurrences":1,"effects":[{"op":"draw_to_limit","side":"target","when":{"hand_id":"full_house"}},{"op":"capture_query","query":{"side":"target","zone":"hand","order":"zone","filters":{"card_kind":"normal"}},"capture":"enemy_hand"},{"op":"apply_card_anomaly_to_captured","capture":"enemy_hand","random_options":[{"category":"state","anomaly":"vulnerability"},{"category":"state","anomaly":"acupoint_block"},{"category":"poison","anomaly":"lethal_poison"},{"category":"poison","anomaly":"stagnant_poison"}]}]}]
