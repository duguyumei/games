automatic_triggers = [{"id":"hundred_forms_furnace","event":"technique_succeeded","filters":{"event_actor_is_owner":true,"technique_id_not_in":["high_fire_hundred_forms_furnace"]},"timing":"immediate","progress":{"marker_id":"other_technique_records","threshold":3,"consume":3,"retain_overflow":true,"ordered_fields":[{"field":"initial_power"},{"field":"hand_id"},{"field":"technique_id"},{"field":"trigger_mode"}]},"p0":{"kind":"divide_floor","value":{"kind":"capture_field_sum","capture":"automatic_progress_group","field":"initial_power"},"divisor":3}}]
description = "每当我方累计成功发动3门其他功法，按稳定顺序记录它们的P₀和精确牌型并自动触发本功法。特殊P₀等于三者P₀平均值，造成P点普通伤害；若三门功法包含至少2种不同的精确牌型，同气槽+1。主动触发时效果无效，但正常结算连势、同气、事件与序列推进，且不清除记录。本功法所有同ID副本的发动均不计数。"
