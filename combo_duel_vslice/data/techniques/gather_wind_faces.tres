[resource]
script = ExtResource("1")
id = "gather_wind_faces"
display_name = "引风聚首"
pool = "three"
description = "造成P点伤害；随机使我方牌库3张普通真气获得风引；葫芦在下个回合正常补牌后额外抽2张J、Q或K。"
effects = [{"op":"damage","amount":{"kind":"power"}},{"op":"capture_query","query":{"side":"actor","zone":"draw_pile","order":"random","limit":3,"filters":{"card_kind":"normal"}},"capture":"lure_targets"},{"op":"apply_card_anomaly_to_captured","capture":"lure_targets","category":"mark","anomaly":"wind_lure"},{"op":"register_delayed_effects","timing":"after_normal_draw","occurrences":1,"when":{"hand_id":"full_house"},"effects":[{"op":"draw_filtered","query":{"side":"actor","zone":"draw_pile","order":"top","limit":2,"filters":{"rank_names":["J","Q","K"],"card_kind":"normal"}},"capture":"faces"}]}]
