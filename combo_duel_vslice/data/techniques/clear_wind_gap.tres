[resource]
script = ExtResource("1")
id = "clear_wind_gap"
display_name = "清风过隙"
pool = "high"
description = "造成 P 点伤害；抽 1 张，再随机弃 1 张；首次抽到风时额外抽 1 张。"
effects = [{"op":"damage","amount":{"kind":"power"}},{"op":"draw","count":{"kind":"constant","value":1},"capture":"first_draw"},{"op":"discard_random","count":{"kind":"constant","value":1}},{"op":"draw_if_captured_attribute","capture":"first_draw","attribute":"wind","count":1}]
