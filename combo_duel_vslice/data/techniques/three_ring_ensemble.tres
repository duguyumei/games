[ext_resource type="Script" path="res://core/technique_definition.gd" id="1"]
[resource]
script = ExtResource("1")
id = "three_ring_ensemble"
display_name = "三环并奏"
pool = "three"
special = true
description = "造成floor(P/2)伤害；可协同1个合法一对组，主牌型组与协同组使用协同共享功法值。"
